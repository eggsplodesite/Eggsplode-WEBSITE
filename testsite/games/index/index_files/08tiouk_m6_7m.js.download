a.list-header {
  display: inline-block;
}
img.header-thumb, img.avatar-card-image {
  height: 85px;
  width: auto;
  display: inline-block;
}
ul.vlist.feeds {
  padding: 0;
  list-style: none;
}
div.list-body {
  display: inline-block;
  margin-left: 10px;
  max-width: calc(100% - 100px);
}
html,body {
  font-family: "Source Sans Pro", serif;
  background-color: ${e?"#272930":"#ffffff"};
  color: ${e?"rgb(247, 247, 248)":"inherit"};
}
p {
  padding: 0;
  margin: 0;
  ${e?"color: rgb(247, 247, 248);":""}
}
p.feedtext {
  color: ${e?"rgb(247, 247, 248)":"inherit"};
  padding: 10px 0;
}
p.list-content {
  ${e?"color: rgb(247, 247, 248);":""}
}
span.xsmall {
  color: ${e?"#a0a0a0":"#777"};
  font-size: 12px;
}
a {
  color: ${e?"#6ea8fe":"#00a2ff"};
  text-decoration: none;
}
a:visited {
  color: ${e?"#6ea8fe":"#00a2ff"};
}
a.text-name {
  color: ${e?"#6ea8fe":"#00a2ff"};
}
li.list-item {
  padding-bottom: 20px;
  border-bottom: 1px solid ${e?"#3a3a3a":"#c3c3c3"};
  padding-top: 10px;
}
span.icon-report {
